# Runtime
NODE_ENV=development
LOG_LEVEL=info
TZ=America/Los_Angeles

# Database (Plan 01 / future phases)
DB_PATH=/data/fishcount.sqlite3

# Kill switch (Plan 03 — OPS-05). Unset = scraping allowed. "false" = halted.
# Set in prod via: fly secrets set SCRAPER_ENABLED=false
# SCRAPER_ENABLED=false

# Litestream / Backblaze B2 (Plan 01 — OPS-03). Prod-only; set via fly secrets.
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_BUCKET=fishcount-backup
# LITESTREAM_ENDPOINT=s3.us-west-000.backblazeb2.com

# Dead-man's switch (Plan 04 — OPS-04). Prod-only; set via fly secrets.
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>

# Operator alerts via Resend (Plan 05 — OPS-01). Prod-only; set via fly secrets.
# RESEND_API_KEY=re_...
# OPERATOR_EMAIL=ops@fishcount.example
# OPERATOR_FROM_EMAIL=alerts@fishcount.example

# Structured logging shipper (Plan 02 — OPS-06). Prod-only; set via Fly Log Shipper.
# BETTER_STACK_SOURCE_TOKEN=

# Billing watcher (Plan 05 — OPS-01). GitHub Actions secret, NOT a Fly secret.
# FLY_API_TOKEN=
# FLY_ORG_SLUG=personal
# BILLING_TEST_SPEND=   # optional override for threshold-alert integration test

# ---------- Phase 4: Email Alerts ----------
# PROJECT_SECRET — HMAC signing key for confirm/manage/unsubscribe tokens (Plan 04-02).
# MUST be at least 32 characters. Fail-closed: tokens.ts throws on missing/short secret.
# Generate: openssl rand -base64 32
PROJECT_SECRET=replace-me-32-chars-or-more-please-rotate-on-leak

# POSTAL_ADDRESS — physical mailing address rendered in every outbound email
# compliance footer (Plan 04-03). CAN-SPAM 15 U.S.C. § 7704(a)(5) mandate.
# Fail-closed: postalAddress.ts throws when unset; emails refuse to render.
# Recommend a virtual mailbox / P.O. Box, NOT operator's home address (UI-SPEC §FLAG #10).
POSTAL_ADDRESS=PO Box 1, San Diego CA 92101

# RESEND_API_KEY — already used by Phase 0 operator alerts; reused for subscriber stream.
# Scope: send-only. Rotate on suspected leak. Stored in Fly.io secrets in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SUBSCRIBER_FROM_EMAIL — From: address for subscriber-facing mail (Plan 04-03).
# Distinct from OPERATOR_FROM_EMAIL so DMARC reports can isolate per-stream complaints.
# MUST be a domain verified in Resend (SPF + DKIM passing) before first send.
SUBSCRIBER_FROM_EMAIL=alerts@fishcount.app

# PUBLIC_BASE_URL — base URL for confirm/manage/unsubscribe URLs in email body
# (Plan 04-04 + 04-07). MUST match the production domain or links will 404.
PUBLIC_BASE_URL=https://fishcount.app

# HOT_DAY_MIN_ANGLERS — integer override for ALT-09 sample-size floor (Plan 04-07).
# Default 8 (Pitfall 5 mitigation). Lower = noisier alerts on slow weekdays.
# Higher = misses real hot days on small-boat trips.
HOT_DAY_MIN_ANGLERS=8

# WARMUP_START_DATE — YYYY-MM-DD (Pacific) anchor for the 50/200/full warm-up
# schedule (Plan 04-02 + Plan 04-07). UNSET = no cap (post-warmup steady state).
# During warmup: 50/day in week 1, 200/day in week 2, unlimited from week 3.
# Set this to TODAY when going live with the first production batch.
# WARMUP_START_DATE=2026-05-01
